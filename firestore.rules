rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nutzerprofile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Kalender: nur Mitglieder dürfen lesen; nur Owner darf löschen/Mitglieder ändern
    match /calendars/{calId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members[request.auth.uid] == 'owner';

      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && (resource.data.members[request.auth.uid] in ['owner', 'editor']);

      allow delete: if request.auth != null
        && resource.data.owner == request.auth.uid;

      // Events innerhalb eines Kalenders
      match /events/{eventId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/calendars/$(calId)).data.members;
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/calendars/$(calId)).data.members[request.auth.uid] in ['owner', 'editor'];
      }

      // Listen (Einkauf / To-Do) und deren Items
      match /lists/{listId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/calendars/$(calId)).data.members;
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/calendars/$(calId)).data.members[request.auth.uid] in ['owner', 'editor'];

        match /items/{itemId} {
          allow read: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/calendars/$(calId)).data.members;
          allow write: if request.auth != null
            && get(/databases/$(database)/documents/calendars/$(calId)).data.members[request.auth.uid] in ['owner', 'editor'];
        }
      }
    }
  }
}
